# Copy to `.env.development` (and/or `.env.production`) and adjust as needed.
# Vite only exposes vars prefixed with VITE_ to the client bundle. There are NO
# secrets here — an App Block never holds credentials; the Civitai host injects
# the block token + viewer identity over postMessage at runtime.

# Comma-separated origins the SDK iframe transport will accept BLOCK_INIT from.
# The host drops any postMessage whose origin isn't allow-listed here.
#   - Local dev harness (see `pnpm run dev:harness`): http://localhost:5188
#   - Production: the Civitai host origin, baked in at build time by the platform.
VITE_BLOCK_ALLOWED_PARENT_ORIGINS=https://civitai.com
